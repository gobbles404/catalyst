 from pyinstrument import Profiler
 
@@ -45,14 +46,20 @@ def workloads() -> dict[str, Callable[[], object]]:
     mixed = Cells.from_rows([[["nn", 1.0, True][i % 3]] for i in range(n)])
     headers = Cells.from_rows([["date", "product", "quantity", "cleared"]])
     trades = Cells.from_rows([[46276.0 + i, f"p{i}", float(i), i % 2 == 0] for i in range(n // 4)])
-    # The reader's handle: a ten-year curve created once here, since a creator under the
-    # profiler would retain a curve per call.
-    curve = ENTRY["_CreateDiscountCurve"](
-        Cells.from_rows([["date", "discount_factor"]]),
-        Cells.from_rows([[46276.0 + i, 1.0 - i * 1e-5] for i in range(3_631)]),
-    )
+    # The reader's handle: a ten-year curve created once here. The creator's own workload
+    # releases each curve it publishes, so the store does not grow under the profiler.
+    curve_headers = Cells.from_rows([["date", "discount_factor"]])
+    curve_body = Cells.from_rows([[46276.0 + i, 1.0 - i * 1e-5] for i in range(3_631)])
+    curve = ENTRY["_CreateDiscountCurve"](curve_headers, curve_body)
+    holidays = Cells.from_rows([[46023.0 + 7 * i] for i in range(1_000)])
     return {
         "util_ReadHandle": lambda: ENTRY["util_ReadHandle"](curve),
+        "_CreateDiscountCurve": lambda: bridge.release(
+            cast(str, ENTRY["_CreateDiscountCurve"](curve_headers, curve_body))
+        ),
+        "_CreateHolidayCalendar": lambda: bridge.release(
+            cast(str, ENTRY["_CreateHolidayCalendar"](holidays))
+        ),
         "Zero": lambda: ENTRY["Zero"](),
         "Add": lambda: ENTRY["Add"](1.0, 2.0),
         "Times": lambda: ENTRY["Times"](5.0, MISSING),
