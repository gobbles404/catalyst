From 5562821bf9f1f34bc840f0b2b2ee9fbb44bfd422 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 11:49:08 +0000
Subject: [PATCH] instrument-allocation-creators-release: a creator's peak is
 one call released inside it, not the least of three retained

---
 tests/performance/test_seam_allocation.py | 71 +++++++++++++++++++------------
 1 file changed, 44 insertions(+), 27 deletions(-)

diff --git a/tests/performance/test_seam_allocation.py b/tests/performance/test_seam_allocation.py
index a9135e4..72ad1a3 100644
--- a/tests/performance/test_seam_allocation.py
+++ b/tests/performance/test_seam_allocation.py
@@ -164,9 +164,9 @@ def test_a_mixed_array_out_peaks_at_its_masks_and_its_joined_text() -> None:
 
 # --- handles ------------------------------------------------------------------
 # A creator keeps what it makes: the record, its entry in the store and its text; a reader
-# keeps nothing, and its numpy scalars are the small objects. Each is the least of three warm
-# calls, so that a resize of the store's dictionary, which lands on one call in many, never
-# lands on the pin.
+# keeps nothing, and its numpy scalars are the small objects. A creator's peak is one warm call
+# whose publication is released inside it, so the store never grows and a resize of its
+# dictionary never lands on the pin; a reader's is the least of three warm calls.
 
 CURVE_HEADERS = Cells.from_rows([["date", "discount_factor"]])
 
@@ -179,11 +179,21 @@ def least_peak(fn: Callable[[], object]) -> int:
     return min(peak_bytes(fn) for _ in range(3))
 
 
+def creator_peak(create: Callable[[], object]) -> int:
+    """The peak of one warm creator call, its publication released inside the call: the release
+    comes after the peak and allocates nothing."""
+
+    def call() -> None:
+        bridge.release(cast(str, create()))
+
+    return peak_bytes(call)
+
+
 # Measured 1,176 bytes for the valuation date on 2026-09-14, and 1,671 for reading it back as a
 # three-row table on 2026-09-15: the record and its entry, then the kinds, the slots and the
 # masks of six cells.
 def test_a_creator_of_a_small_object_and_its_reader_stay_small() -> None:
-    assert least_peak(lambda: ENTRY["_CreateValuationDate"](46276.0, 0.5)) <= 2 * SLACK
+    assert creator_peak(lambda: ENTRY["_CreateValuationDate"](46276.0, 0.5)) <= 2 * SLACK
     handle = ENTRY["_CreateValuationDate"](46276.0, 0.5)
     assert least_peak(lambda: ENTRY["util_ReadHandle"](handle)) <= 2 * SLACK
 
