 def calendar_sources(contracts: int) -> tuple[object, object]:
     """The two handles a calendar takes: the valuation date, and the index of a schedule of that
     many monthly contracts a month apart with a calendar of a hundred holidays a week apart."""
@@ -406,6 +468,12 @@ def test_a_calendar_keeps_four_columns_and_its_reader_pays_per_cell() -> None:
     assert least_peak(lambda: ENTRY["util_ReadHandle"](made)) <= 20 * 4 * days + 2 * SLACK
 
 
+# A calendar keeps its four columns, 18 bytes per day, and nothing else.
+def test_a_calendar_keeps_exactly_its_four_columns() -> None:
+    valuation, index = calendar_sources(13)
+    assert retained_numpy_bytes(lambda: ENTRY["_CreateCalendar"](valuation, index)) == (18 * 360, 0)
+
+
 def gas_daily_month_columns(months: int) -> tuple[Cells, Cells, Cells]:
