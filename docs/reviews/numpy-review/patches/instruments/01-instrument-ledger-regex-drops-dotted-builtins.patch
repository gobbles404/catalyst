@@ -1204,6 +1209,7 @@ def test_a_calendar_is_two_handles_in_and_four_columns_out(
         "numpy.arange": 1,  # every day, once
         "ndarray.searchsorted": 1,  # the prompt row of every day, once
         "ndarray.setflags": 4,  # the four columns frozen
+        "numpy.count_nonzero": 1,  # the fixed periods, which come first
         "ufunc.reduce": 1,
     }
 
@@ -1241,6 +1247,7 @@ def test_reading_a_calendar_back_rebuilds_nothing(
         "numpy.datetime_data": 1,  # the unit of the date column
