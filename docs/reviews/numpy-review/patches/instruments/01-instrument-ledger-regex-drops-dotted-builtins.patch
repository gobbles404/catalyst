@@ -1525,6 +1534,7 @@ def test_reading_a_market_history_back_rebuilds_nothing(
         "numpy.datetime_data": 1,  # the unit of the date column
         "ndarray.any": 5,  # the serials' two checks, then the mixed road's three looks
