     assert "numpy.arange" not in calls and "ndarray.searchsorted" not in calls
@@ -1294,6 +1301,7 @@ def test_a_gas_daily_calendar_is_an_index_and_a_valuation_date_in_and_four_colum
         "ndarray.searchsorted": 1,
