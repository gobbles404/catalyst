+# The date rule's passes over a column of dates: the whole-number test, the two bounds and the
+# kinds compare, their masks joined, one look, and the shift to days. Seventy-four bytes read
+# or written per cell, over the nine the column holds.
+def test_a_date_column_in_is_eight_ufuncs_over_eight_times_its_bytes(
+    ufunc_ledger: Callable[..., tuple[dict[str, int], int]],
+) -> None:
+    column = Cells.from_rows([[float(61 + i)] for i in range(N)])
+    ufuncs, touched = ufunc_ledger(PATH["FirstOfDates"], column)
+    assert ufuncs == {
+        "floor": 1,
+        "not_equal": 1,
+        "less": 1,
+        "greater": 1,
+        "bitwise_or": 2,
+        "logical_or.reduce": 1,
+        "add": 1,
+    }
+    assert touched == 74 * N
+
