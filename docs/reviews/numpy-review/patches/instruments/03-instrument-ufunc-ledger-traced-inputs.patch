index e61582a..a735795 100644
--- a/tests/performance/conftest.py
+++ b/tests/performance/conftest.py
@@ -5,12 +5,13 @@ import re
 import sys
 from collections.abc import Callable
 from pathlib import Path
+from typing import Any
 
 import numpy as np
 import pytest
 
 import goosedove
-from goosedove.excel.bridge import DateColumn, NumberColumn, TextColumn
+from goosedove.excel.bridge import Cells, DateColumn, NumberColumn, TextColumn
 from goosedove.excel.probes import probe
 
 PACKAGE_DIR = str(Path(goosedove.__file__).parent)
@@ -143,3 +144,50 @@ def _numpy_callables(fn: Callable[[], object]) -> dict[str, int]:
 @pytest.fixture
 def numpy_callables() -> Callable[[Callable[[], object]], dict[str, int]]:
     return _numpy_callables
+
+
+UfuncLedger = tuple[dict[str, int], int]
+
+
+def _ufunc_ledger(call: Callable[..., object], *args: object) -> UfuncLedger:
+    """Every ufunc the call ran over the storage of its ranges, operators included, and the
+    bytes their operands and results held in all: the passes over the data, counted in bytes.
+
+    Each range in args is handed over with its kinds and numbers viewed through an ndarray
+    subclass made for this one count, which reports each ufunc it takes part in and keeps its
+    results reporting, so a mask's reduction counts too. A copy taken with np.array or
+    np.asarray is a plain array again, so a record's own columns are never counted, and a
+    result the seam returns as an array is refused as a subclass: count the way in, not the
+    way out.
+    """
+    ufuncs: dict[str, int] = {}
+    moved = [0]
+
+    class Traced(np.ndarray[Any, Any]):
+        def __array_ufunc__(self, ufunc: Any, method: str, *inputs: Any, **kwargs: Any) -> Any:
+            plain = tuple(i.view(np.ndarray) if isinstance(i, np.ndarray) else i for i in inputs)
+            out = kwargs.get("out")
+            if out is not None:
+                kwargs["out"] = tuple(o.view(np.ndarray) for o in out)
+            result = getattr(ufunc, method)(*plain, **kwargs)
+            touched = sum(i.nbytes for i in plain if isinstance(i, np.ndarray))
+            if isinstance(result, np.ndarray):
+                touched += result.nbytes
+                result = result.view(Traced)
+            key = ufunc.__name__ if method == "__call__" else f"{ufunc.__name__}.{method}"
+            ufuncs[key] = ufuncs.get(key, 0) + 1
+            moved[0] += touched
+            return result
+
+    def traced(arg: object) -> object:
+        if isinstance(arg, Cells):
+            return Cells(arg.kinds.view(Traced), arg.numbers.view(Traced), arg.texts, arg.seen)
+        return arg
+
+    call(*(traced(arg) for arg in args))
+    return ufuncs, moved[0]
+
+
+@pytest.fixture
+def ufunc_ledger() -> Callable[..., UfuncLedger]:
+    return _ufunc_ledger
