+# date; 69,367 at 2,600 and 677,767 at 26,000, 26 bytes per row, so a ceiling of 35 per row.
 def test_futures_fixings_keep_a_copy_of_each_column() -> None:
     rows = 260
     codes, futures, _, _ = schedule_columns(2)
@@ -378,7 +378,7 @@ def test_futures_fixings_keep_a_copy_of_each_column() -> None:
     days, settles = fixings_columns(rows, 100)
     assert (
         least_peak(lambda: ENTRY["_CreateFuturesFixings"](days, settles, index))
-        <= 45 * rows + SLACK
+        <= 35 * rows + SLACK
     )
 
 
