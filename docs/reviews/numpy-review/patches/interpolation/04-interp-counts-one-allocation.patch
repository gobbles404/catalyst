From 90c6a61cc6c4610976c3abf0d368e98fa4a6133f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 11:29:45 +0000
Subject: [PATCH] interp-counts-one-allocation: The day counts per anchor read
 as int64 in place, not copied by astype

---
 src/goosedove/globals/interpolation.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/goosedove/globals/interpolation.py b/src/goosedove/globals/interpolation.py
index c8c5b65..6e41a43 100644
--- a/src/goosedove/globals/interpolation.py
+++ b/src/goosedove/globals/interpolation.py
@@ -35,7 +35,7 @@ def interpolate_discount_factors(
     offsets = (dates - dates[0]) / ONE_DAY
     values = np.interp(np.arange(days.size, dtype=np.float64), offsets, factors)
     # The anchor each day runs to: the first anchor for its own day, then each later anchor for
-    # every day since the one before it.
-    counts = np.concatenate(([1], (dates[1:] - dates[:-1]).astype(np.int64)))
+    # every day since the one before it, the gaps' whole days read as int64 where they lie.
+    counts = np.concatenate(([1], (dates[1:] - dates[:-1]).view(np.int64)))
     np.maximum(values, np.repeat(factors, counts), out=values)
     return days, values
