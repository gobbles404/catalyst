<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <!-- One place uses a pointer: the copy of an array out of Python's buffer into the array Excel receives. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Only [ExcelFunction] methods and the functions registered from Python reach the sheet;
         HostAdd, unmarked, reaches it only where the probes were loaded. -->
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
    <!-- The add-in is named for the product, not for the assembly: the build makes one 64-bit
         Catalyst.xll with its Catalyst.dna, loading Catalyst.Host.dll beside them, and Excel's
         add-in list shows it as Catalyst. There is no 32-bit build: the add-in loads a 64-bit Python. -->
    <ExcelAddInName>Catalyst</ExcelAddInName>
    <ExcelAddInFileName>Catalyst</ExcelAddInFileName>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDna64BitAddInSuffix>%none%</ExcelDna64BitAddInSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <!-- The help beside the formula as a person types it, read from the same registration Excel's fx dialog reads. -->
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.9.0" />
    <PackageReference Include="pythonnet" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="catalyst.cfg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('catalyst.cfg')" />
  </ItemGroup>

</Project>
