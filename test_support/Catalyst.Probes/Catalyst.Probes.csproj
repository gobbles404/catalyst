<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The attribute alone, at the host's own Excel-DNA version: the add-in that loads this
         library brings Excel-DNA itself, so its assembly is compiled against and never copied
         beside this one. -->
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
